{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the user, corresponding to their Firebase Auth UID."
        },
        "months": {
          "type": "object",
          "description": "An object where each key is a month identifier (e.g., '2024-10') and the value is the data for that month.",
          "additionalProperties": {
            "$ref": "#/entities/MonthData"
          }
        }
      },
      "required": ["id", "months"]
    },
    "MonthData": {
      "title": "MonthData",
      "type": "object",
      "description": "Contains all financial data for a specific month.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the month, in 'yyyy-MM' format."
        },
        "year": {
          "type": "number",
          "description": "The year of the month."
        },
        "month": {
          "type": "number",
          "description": "The month number (1-12)."
        },
        "childSupport": {
          "$ref": "#/entities/ChildSupport"
        },
        "expenseSplit": {
          "$ref": "#/entities/ExpenseSplit"
        },
        "medicalExpenseSplit": {
          "$ref": "#/entities/ExpenseSplit"
        },
        "parentNames": {
          "$ref": "#/entities/ParentNames"
        },
        "expenses": {
          "type": "array",
          "description": "A list of expenses for the month.",
          "items": {
            "$ref": "#/entities/Expense"
          }
        }
      },
      "required": ["id", "year", "month", "childSupport", "expenseSplit", "parentNames", "expenses", "medicalExpenseSplit"]
    },
    "ChildSupport": {
      "title": "ChildSupport",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "paidBy": { "type": "string", "enum": ["Parent 1", "Parent 2", "None"] },
        "status": { "type": "string", "enum": ["Paid", "Unpaid"] }
      },
      "required": ["amount", "paidBy", "status"]
    },
    "ExpenseSplit": {
      "title": "ExpenseSplit",
      "type": "object",
      "properties": {
        "Parent 1": { "type": "number" },
        "Parent 2": { "type": "number" }
      },
      "required": ["Parent 1", "Parent 2"]
    },
    "ParentNames": {
      "title": "ParentNames",
      "type": "object",
      "properties": {
        "Parent 1": { "type": "string" },
        "Parent 2": { "type": "string" }
      },
      "required": ["Parent 1", "Parent 2"]
    },
    "Expense": {
      "title": "Expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "paidBy": { "type": "string", "enum": ["Parent 1", "Parent 2"] },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["Paid", "Unpaid"] },
        "year": { "type": "number" },
        "month": { "type": "number" }
      },
      "required": ["id", "date", "description", "amount", "paidBy", "category", "status", "year", "month"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/entities/User"
          },
          "description": "Stores all data for a single user, keyed by their auth UID. All monthly data is nested within this document.",
          "params": [
            {
              "name": "userId",
              "description": "The unique ID of the user, matching their Firebase Auth UID."
            }
          ]
        }
      }
    ]
  }
}
