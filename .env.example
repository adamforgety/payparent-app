# ==============================================================================
# PayParent Environment Variables
# ==============================================================================

# Gemini AI (for optional AI insights)
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Integration (Required for processing live payments)
# Obtain these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook Secret from Stripe Dashboard > Developers > Webhooks
# Endpoint: https://yourdomain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (created in Stripe Products catalog)
# Suggested: Monthly ($3.99/mo) and Annual ($29/yr)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Google Sheets Integration (for 2-Way Sync between PayParent and Google Sheets)
# Create a free Service Account in Google Cloud Console > IAM & Admin > Service Accounts
# Download JSON key or copy the client email and private key:
GOOGLE_SERVICE_ACCOUNT_EMAIL=payparent-sync@studio-4986545832-761cd.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_GOOGLE_SERVICE_ACCOUNT_EMAIL=payparent-sync@studio-4986545832-761cd.iam.gserviceaccount.com
