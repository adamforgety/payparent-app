/**
 * @fileOverview Firestore Security Rules for CoParent Finances App
 *
 * Core Philosophy:
 * This ruleset enforces a shared data model based on a `dataOwnerId`.
 * A user can read/write data in another user's document if their own `dataOwnerId`
 * points to that other user's ID. This creates a shared account where both users
 * access the same data source.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, including `coParentId` and `dataOwnerId`.
 * - /users/{userId}/...: User-specific data like `appData`.
 *
 * Key Security Decisions:
 * - A user must be authenticated to access any data.
 * - Any authenticated user can read any other user's profile to verify existence before linking. This does not expose sub-collections.
 * - A user can write to another user's profile ONLY to establish or break a `coParentId` and `dataOwnerId` link.
 * - All other data writes (`appData`, etc.) are only allowed on the document specified by the user's `dataOwnerId`.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helper functions for authentication and ownership
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Check if the requesting user is linked to the target user
     * (either targetUserId is the dataOwnerId or the coParentId of the requester,
     * or the target document lists the requester as its coParentId/dataOwnerId)
     */
    function isLinked(targetUserId) {
      let requesterDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && (
        requesterDoc.dataOwnerId == targetUserId ||
        requesterDoc.coParentId == targetUserId ||
        resource.data.coParentId == request.auth.uid ||
        resource.data.dataOwnerId == request.auth.uid
      );
    }

    /**
     * Check if the requester is authorized to write appData to this data owner's document
     */
    function isAuthorizedDataWriter(userId) {
      let requesterDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() &&
             requesterDoc.dataOwnerId == userId &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appData']);
    }

    /**
     * Allow establishing a co-parent link on the target document
     * (Only allows modifying coParentId, sets it to request.auth.uid, and only if currently unlinked)
     */
    function isLinkingCoParent(userId) {
      return isAuthenticated() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coParentId']) &&
             request.resource.data.coParentId == request.auth.uid &&
             (resource.data.coParentId == null || resource.data.coParentId == '');
    }

    /**
     * Allow breaking a co-parent link on the co-parent's document
     */
    function isUnlinkingCoParent(userId) {
      return isAuthenticated() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coParentId']) &&
             request.resource.data.coParentId == null &&
             resource.data.coParentId == request.auth.uid;
    }

    /**
     * Allow the data owner to release a linked subordinate co-parent back to their own ownership
     */
    function isOwnerUnlinkingSubordinate(userId) {
      return isAuthenticated() &&
             resource.data.dataOwnerId == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coParentId', 'dataOwnerId']) &&
             request.resource.data.coParentId == null &&
             request.resource.data.dataOwnerId == userId;
    }

    match /users/{userId} {
      // Strictly private: Only the document owner or an authorized linked co-parent can read
      allow get: if isOwner(userId) || isLinked(userId);

      // Block list queries across all users to prevent user scraping
      allow list: if false;

      // Allow users to create only their own profile with matching ID
      allow create: if isOwner(userId) && request.resource.data.id == userId;

      // Secure updates
      allow update: if (isOwner(userId) && request.resource.data.id == resource.data.id) ||
                      isAuthorizedDataWriter(userId) ||
                      isLinkingCoParent(userId) ||
                      isUnlinkingCoParent(userId) ||
                      isOwnerUnlinkingSubordinate(userId);

      // No direct client deletions
      allow delete: if false;
    }
  }
}

