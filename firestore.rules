/**
 * @fileOverview Firestore Security Rules for CoParent Finances App
 *
 * Core Philosophy:
 * This ruleset enforces a shared data model based on a `dataOwnerId`.
 * A user can read/write data in another user's document if their own `dataOwnerId`
 * points to that other user's ID. This creates a shared account where both users
 * access the same data source.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, including `coParentId` and `dataOwnerId`.
 * - /users/{userId}/...: User-specific data like `appData`.
 *
 * Key Security Decisions:
 * - A user must be authenticated to access any data.
 * - Any authenticated user can read any other user's profile to verify existence before linking. This does not expose sub-collections.
 * - A user can write to another user's document ONLY to establish or break a `coParentId` and `dataOwnerId` link.
 * - All other data writes (`appData`, etc.) are only allowed on the document specified by the user's `dataOwnerId`.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helper function to check if the requesting user is the owner of the document.
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is authorized to access the target data.
     * Access is granted if the requester's dataOwnerId matches the ID of the document they are trying to access.
     */
    function isAuthorizedToAccessData(targetUserId) {
      let requesterDataOwnerId = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dataOwnerId;
      return requesterDataOwnerId == targetUserId;
    }

    /**
     * @description Rules for the user profile document.
     * - Any authenticated user can read any profile for linking.
     * - Writes are complex:
     *   - Owners can update their own profile.
     *   - A user can write to another's profile ONLY to set the coParentId/dataOwnerId for linking.
     *   - App data can only be written if the user is authorized to access the target data document.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if request.auth != null;

      // Allow write for linking/unlinking OR if the user is authorized to write to this data document.
      allow write: if isOwner(userId) ||
                      (request.resource.data.keys().hasAny(['coParentId', 'dataOwnerId'])) ||
                      isAuthorizedToAccessData(userId);
    }
  }
}
