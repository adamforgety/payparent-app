/**
 * @fileOverview Firestore Security Rules for CoParent Finances App
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model where data can be shared with a single co-parent.
 * A user can read/write their own data. They can also read/write their co-parent's data if the `coParentId` in their own user document points to the other user's ID.
 *
 * Data Structure:
 * All data is nested under `/users/{userId}`, creating a clear separation of user data.
 * - `/users/{userId}`: Stores user profile information, including a `coParentId`.
 * - `/users/{userId}/...`: All other user-specific data.
 *
 * Key Security Decisions:
 * - A user must be authenticated to access any data.
 * - A user can write to their own `/users/{userId}` document.
 * - Any authenticated user can read any other user's profile to verify existence before linking. This does not expose sub-collections.
 * - A user can write to another user's `coParentId` field ONLY to set it to their own ID, enabling the linking handshake.
 *
 * Denormalization for Authorization:
 * The `coParentId` is stored directly in the user's document. This requires one `get()` call to check for the relationship, but avoids complex hierarchical rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helper function to check if the requesting user is the owner of the document.
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * Helper function to check if the requesting user is a linked co-parent of the document owner.
     * This grants access if the current user's coParentId points to the owner of the data they are trying to access.
     */
    function isCoParent(ownerId) {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coParentId == ownerId;
    }
    
    /**
     * @description Helper function to check if the write operation is only an attempt to link or unlink accounts.
     * A write is allowed if it's the user updating their own coParentId, OR if they are setting another user's coParentId to their own uid.
     */
    function isLinkingOperation(userId) {
        // The requesting user must be authenticated.
        if (request.auth == null) {
            return false;
        }

        let isUpdatingSelf = 
            // The document being written to IS the requester's own document.
            isOwner(userId) &&
            // The write is only modifying the `coParentId` and other expected fields.
            // This prevents overwriting other sensitive data.
            request.resource.data.diff(resource.data).affectedKeys.hasOnly(['coParentId']);

        let isBeingLinkedByOther =
            // The document being written to is NOT the requester's own document.
            !isOwner(userId) &&
            // The write is only modifying the `coParentId` field.
            request.resource.data.diff(resource.data).affectedKeys.hasOnly(['coParentId']) &&
            // The value being written to `coParentId` is the requester's own UID.
            request.resource.data.coParentId == request.auth.uid;
            
        // The operation is allowed if the user is linking to another user
        // OR if they are updating their own coParentId (to link or unlink).
        return isUpdatingSelf || isBeingLinkedByOther;
    }


    /**
     * @description Rules for the user's own profile document.
     * - A user can write to their own profile.
     * - Any authenticated user can read any other user's profile to verify existence before linking.
     * - A user can write to another user's `coParentId` to link accounts.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow write: if isLinkingOperation(userId);
      allow get: if request.auth != null;
    }
    
    /**
     * @description Rules for all data nested under a user's document (expenses, payments, etc.).
     * Access is granted if the requester is the owner OR the linked co-parent of the owner.
     * This creates the shared data model.
     * @path /users/{userId}/{document=**}
     */
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isCoParent(userId);
    }
  }
}
